@startuml UrbanGen_AI_Complete_Architecture
' ==============================================================================
' UrbanGen AI: Multi-Model Deep Generative Framework for Satellite Imagery Processing
' Complete Integrated System Pipeline & Security Architecture (PlantUML)
' Department of Computer Engineering, MIT Academy of Engineering, Pune
' B.Tech Capstone Project (2025–2026) · IEEE Publication Track
' ==============================================================================

skinparam dpi 300
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam roundcorner 8
skinparam shadowing true
skinparam packageTitleAlignment left
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30

' Academic Color Palette
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  BorderThickness 1.5
  FontStyle bold
  FontSize 12
}

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #0284C7
  BorderThickness 1.4
  FontSize 10.5
}

skinparam arrow {
  Color #0284C7
  Thickness 1.6
  FontSize 9.5
  FontStyle bold
}

' ==============================================================================
' TIER 1: INGESTION, RESTORATION & LATENT MANIFOLD
' ==============================================================================
package "1. Remote Sensing Ingestion and Perturbation" #F0F9FF {
  rectangle RAW [
<b>USGS UCMerced Orthoimagery</b>
--
• 2,100 Aerial Tiles (256x256 px, 0.3m GSD)
• 21 Municipal Land-Use Classes
• Stratified Split (1,890 Train / 210 Val)
• RGB Spectral Baseline
  ]

  rectangle NOISY [
<b>Atmospheric Degradation Layer</b>
--
• Synthetic Cloud Shadow and Fog Attenuation
• Additive Gaussian Sensor Noise: σ = 0.15
• Corrupted Input Tile: x̃ ∈ ℝ^(128x128x3)
• Simulates Adverse Sensor Weather
  ]

  RAW -right-> NOISY : Optical Scattering
}

package "2. Signal Restoration (Model 1: U-Net DAE)" #ECFDF5 {
  rectangle DAE [
<b>Denoising Autoencoder (U-Net)</b>
--
• Stem → L1(64) → L2(128) → L3(256) → Bottleneck(512)
• Multi-Scale Transposed Skip-Connections
• Loss: L_AE = (1/N) Σ ||x - x̂||₂² (MSE: 0.00449)
• Primary Metric: 29.65 dB PSNR (+7.0 dB Gain)
• Secondary Metric: SSIM = 0.8649
  ]
}

package "3. Latent Manifold and Territorial Auditing" #F5F3FF {
  rectangle VAE [
<b>Spatial β-VAE (Model 2)</b>
--
• ResNet-18 Backbone → Latent μ, log σ² ∈ ℝ^(64x8x8)
• 4-Stage Transposed Conv Decoder (Compact Skips)
• Loss: (0.7*L₁ + 0.3*L_MSE) + 10⁻⁴*D_KL = 0.0483
• Metric: 27.49 dB PSNR | KL: 60.72 nats
  ]

  rectangle ANOMALY [
<b>Unsupervised Anomaly Detector</b>
--
• Disparity Map: |x_restored - x_vae|
• Flagging Threshold: Disparity > 3σ
• Detects Unpermitted Urban Encroachment
• Risk Score Forwarded to Policy Engine
  ]

  rectangle CLS [
<b>Land-Use Classifier (Model 3)</b>
--
• Frozen Semantic Auditor (ResNet-18 + Linear Head)
• Loss Formula: L_CE = -Σ y_i log(p_i) (0.0615)
• Primary Metric: 98.10% Validation Accuracy
• Secondary Metric: Macro F1: 0.9784
  ]

  VAE -right-> ANOMALY : Disparity Map
}

NOISY -right-> DAE : Degraded Tile x̃ (128x128)
DAE -right-> VAE : Clean Tile x̂ (128x128)
DAE -down-> CLS : Clean Tile x̂ (128x128)
VAE .down.> CLS : Latent Manifold Projection

' ==============================================================================
' TIER 2: DUAL-MODALITY GENERATIVE SYNTHESIS & POLICY ENGINE
' ==============================================================================
package "4. Dual-Modality Generative Parcel Synthesis" #FFFBEB {
  rectangle GAN [
<b>Residual cDCGAN (Model 4)</b>
--
• 4x ResUpBlock Generator + Projection Discriminator
• Spectral Normalization + AC-GAN Auxiliary Head
• Loss: L_adv Minimax + 0.8*L_AC (D=1.67, G=1.19)
• Output: High-Speed Synthetic Parcel (<35ms)
• Metric: 99.40% Semantic Proxy Recognition
  ]

  rectangle DIFF [
<b>Conditional DDPM (Model 5)</b>
--
• Time- & Class-Conditioned U-Net (T=1000 Schedule)
• 20-Step Deterministic Accelerated DDIM Sampler
• Loss: L_simple + L_vlb + L_guide + L_sp + L_reg
• Converged Loss: 0.0304 Noise MSE (0.02916 VLB)
• Metric: 1.82s Latency (15.6x Accelerated)
  ]

  GAN -right-> DIFF : Dual Modalities
}

package "5. Grounded Municipal Policy Formulation" #ECFDF5 {
  rectangle GPT [
<b>Municipal Plan Generator (MiniGPT - Model 6)</b>
--
• 4-Layer Pre-LayerNorm Causal Transformer (d_model=256)
• Context Window T=192 | PMC Development Control Rules
• Loss Formula: L_causal = -Σ log P(w_t | w_<t) = 0.1043
• Metrics: 1.110 Validation Perplexity | 0.1505 Bits/Char
  ]

  rectangle BYLAWS [
<b>Actionable Grounded Directives</b>
--
• FSI Allocation: Base FSI 1.8–2.4 along transit spines
• TOD Corridors: 15% Riverbank green buffer setback
• Environmental: Rainwater and solar mandate (>1,000 m²)
  ]

  GPT -right-> BYLAWS : Generates Bylaws
}

CLS -down-> GAN : Condition y ∈ {0..20}
CLS -down-> DIFF : Class Guidance Vector
GAN .up.> CLS : Validation Loop (99.40%)
DIFF .up.> CLS : Classifier Guidance (∇ log p(y|x))

CLS -right-> GPT : Verified Zoning Label y
ANOMALY -down-> GPT : Anomaly Telemetry & Risk Score

' ==============================================================================
' TIER 3: AIR-GAPPED EDGE SECURITY & CLOSED-LOOP GOVERNANCE
' ==============================================================================
package "6. Air-Gapped Edge Hardware and Closed-Loop System Security" #F8FAFC {
  rectangle GATEWAY [
<b>FastAPI Edge Gateway</b>
--
• Verified URBANGEN_API_KEY Header Authentication
• SlowAPI Token-Bucket Rate Limiter (Anti-DDoS)
• Magic-Byte File Inspection (<10MB, Clamped 128x128)
  ]

  rectangle HARDWARE [
<b>Green AI Edge Compute</b>
--
• 100% On-Premises Consumer NVIDIA RTX 4050 Laptop GPU (6GB, 75W)
• Cumulative Training: 66.3 min | Energy: 0.133 kWh | Carbon: 94.8 g CO₂e
• Air-Gapped Zero Cloud GIS Leakage (Complete Data Sovereignty)
  ]

  rectangle GOV [
<b>Human-in-the-Loop Municipal Governance</b>
--
• Generative outputs serve strictly as advisory decision support
• Autonomous legal zoning enforcement is prohibited by design
• Flags high reconstruction disparity outside pre-trained fabrics
  ]

  GATEWAY -right-> HARDWARE : Enforces Hardware Quota
  HARDWARE -right-> GOV : Operational Boundary
}

BYLAWS -down-> GOV : Grounded Policy Directives

@enduml
