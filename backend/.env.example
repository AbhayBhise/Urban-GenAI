# UrbanGen AI — API configuration
# Copy this file to `.env` (which is git-ignored) and adjust as needed.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# If set, every /infer/* and /generate/* endpoint requires the request to
# carry a matching `X-API-Key` header. Leave commented out for local dev.
# URBANGEN_API_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# CORS — comma-separated list of browser origins allowed to call the API
# ---------------------------------------------------------------------------
URBANGEN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Upload + rate limits
# ---------------------------------------------------------------------------
URBANGEN_MAX_UPLOAD_MB=8
URBANGEN_RATE_LIMIT=30/minute
